<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cn.lycoder.boot</groupId>
        <artifactId>yukit</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>yukit-module-system</artifactId>

    <dependencies>
        <dependency>
            <groupId>cn.lycoder.boot</groupId>
            <artifactId>yukit-spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.lycoder.boot</groupId>
            <artifactId>yukit-spring-boot-starter-mybatis</artifactId>
        </dependency>
        <!-- 安全框架：StpUtil 登录能力 -->
        <dependency>
            <groupId>cn.lycoder.boot</groupId>
            <artifactId>yukit-spring-boot-starter-security</artifactId>
        </dependency>
        <!-- 参数校验：@NotBlank 等 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- BCrypt 密码加密（独立轻量包，版本由 Spring Boot BOM 管理） -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <!-- MapStruct 对象映射（编译期生成转换代码，processor 已在根 POM 配置） -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>
        <!-- Hutool 图形验证码：登录验证码生成 -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-captcha</artifactId>
        </dependency>
        <!-- Redis：验证码答案临时存储（StringRedisTemplate，你用到就声明） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
    </dependencies>



</project>