<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cn.lycoder.boot</groupId>
        <artifactId>yukit</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>yukit-server</artifactId>

    <description>服务模块</description>
    <dependencies>
        <!-- Web -->
        <dependency>
            <groupId>cn.lycoder.boot</groupId>
            <artifactId>yukit-spring-boot-starter-web</artifactId>
        </dependency>
        <!-- MyBatis -->
        <dependency>
            <groupId>cn.lycoder.boot</groupId>
            <artifactId>yukit-spring-boot-starter-mybatis</artifactId>
        </dependency>
        <!-- 安全框架 Sa-Token -->
        <dependency>
            <groupId>cn.lycoder.boot</groupId>
            <artifactId>yukit-spring-boot-starter-security</artifactId>
        </dependency>
        <!-- 本地缓存 Caffeine（Spring Cache 抽象） -->
        <dependency>
            <groupId>cn.lycoder.boot</groupId>
            <artifactId>yukit-spring-boot-starter-cache</artifactId>
        </dependency>
        <!-- 系统模块 -->
        <dependency>
            <groupId>cn.lycoder.boot</groupId>
            <artifactId>yukit-module-system</artifactId>
        </dependency>
        <!-- MySQL 驱动 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Sa-Token 会话持久化到 Redis（部署选择，与驱动同理放 server） -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-redis-template</artifactId>
        </dependency>
        <!-- Sa-Token Alone 独立 Redis（Boot4）：会话与业务缓存分库，配合 SaAloneRedisInject 使用 -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-alone-redis-by-spring-boot4</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- Lettuce 连接池依赖 -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>
        <!-- 可观测性：Actuator 健康检查/指标端点（部署关注点，与驱动同理放 server） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Micrometer Prometheus 注册中心：暴露 /actuator/prometheus 供 Prometheus 抓取 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>