<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cn.lycoder.boot</groupId>
        <artifactId>yukit-framework</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>yukit-spring-boot-starter-web</artifactId>

    <dependencies>
        <!-- 内部模块：Result / ServiceException 统一响应 -->
        <dependency>
            <groupId>cn.lycoder.boot</groupId>
            <artifactId>yukit-common</artifactId>
        </dependency>
        <!-- Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- 参数校验：GlobalExceptionHandler 处理校验异常 + 下游模块 ReqVO 注解运行期（Hibernate Validator） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- 接口文档：springdoc-openapi（OpenAPI 3 + Swagger UI），版本由 BOM 管理，classpath 存在时自动装配 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
        <!-- AOP：操作日志切面（@OperationLog）依赖 AspectJ（Boot 4 无 starter-aop，直接依赖 aspectjweaver，版本由 BOM 托管）；
             spring-aop 随 spring-boot-starter-web 传递，AopAutoConfiguration 检测到 AspectJ 即自动开启代理 -->
        <dependency>
            <groupId>org.aspectj</groupId>
            <artifactId>aspectjweaver</artifactId>
        </dependency>

        <!-- JSpecify 空安全注解：Spring 7 的包已打上 @NullMarked，覆写 addInterceptors /
             afterCompletion 的形参需显式标注（版本由 Boot BOM 托管） -->
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>

    </dependencies>

</project>